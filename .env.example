# Telegram Bot Token (BotFather'dan olingan)
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Anthropic Claude API Key (https://console.anthropic.com/ dan olingan)
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE

# Admin Telegram User ID lar (vergul bilan ajratilgan)
ADMIN_IDS=123456789

# Database Connection (PostgreSQL or local SQLite)
# PostgreSQL server uchun: postgresql://postgres:password@localhost:5432/pharmacy_db
# Local SQLite uchun bo'sh qoldiring
DATABASE_URL=

# GitHub Credentials
GITHUB_TOKEN=YOUR_GITHUB_PERSONAL_ACCESS_TOKEN_HERE
GITHUB_REPO_URL=https://github.com/USERNAME/REPO_NAME.git
